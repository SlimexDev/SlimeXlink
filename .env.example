# Local development only. Obtain values from your own Supabase project.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Random server-only value of at least 32 characters; used to hash rate-limit identities.
AUTH_RATE_LIMIT_SECRET=
# Enable only after configuring and testing the Google provider in Supabase.
AUTH_GOOGLE_ENABLED=false
# Random server-only value, at least 32 characters, for the maintenance cron.
CRON_SECRET=

# Separate disposable test project; never use the production project.
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
# Set only after confirming the TEST project is separate and disposable.
TEST_ALLOW_SUPABASE=false

# Avoid sending build/dev telemetry.
NEXT_TELEMETRY_DISABLED=1
